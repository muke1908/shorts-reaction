{
  "name": "youtube-shorts-politics-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "tsx scripts/run-pipeline.ts",
    "copilot:scan": "tsx scripts/run-copilot-workflow.ts",
    "serve": "tsx src/server/index.ts",
    "dev:ui": "vite --config vite.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jimp": "^0.22.12",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
